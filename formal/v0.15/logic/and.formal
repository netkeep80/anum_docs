R : R->R
O : O->R
C : R->C
L : O->C
U : C->O
T : O->C
F : C->O
ARGS_FF : [F,F]
ARGS_FT : [F,T]
ARGS_TF : [T,F]
ARGS_TT : [T,T]
OUT_F : [F]
OUT_T : [T]
AND_SEED : R->L
AND : AND_SEED->O
DICT : AND->R
GRAM : AND->C
THEORY : DICT->GRAM
GT : GRAM->THEORY
INTERP : DICT->GT
FOREIGN_THEORY : THEORY->U
FGT : GRAM->FOREIGN_THEORY
FINTERP : DICT->FGT
ROLE_FF : ARGS_FF->R
ROLE_FT : ARGS_FT->R
ROLE_TF : ARGS_TF->R
ROLE_TT : ARGS_TT->R
ROLES_FF : [ROLE_FF]
ROLES_FT : [ROLE_FT]
ROLES_TF : [ROLE_TF]
ROLES_TT : [ROLE_TT]
ROLE_DICT_FF : ROLE_DICT_FF->ROLES_FF
ROLE_DICT_FT : ROLE_DICT_FT->ROLES_FT
ROLE_DICT_TF : ROLE_DICT_TF->ROLES_TF
ROLE_DICT_TT : ROLE_DICT_TT->ROLES_TT
AND_ARGS_FF : AND->ARGS_FF
AND_ARGS_FT : AND->ARGS_FT
AND_ARGS_TF : AND->ARGS_TF
AND_ARGS_TT : AND->ARGS_TT
INVOCATION_FF : O->AND_ARGS_FF
INVOCATION_FT : O->AND_ARGS_FT
INVOCATION_TF : O->AND_ARGS_TF
INVOCATION_TT : O->AND_ARGS_TT
BEFORE_FF : ROLE_FF->INVOCATION_FF
BEFORE_FT : ROLE_FT->INVOCATION_FT
BEFORE_TF : ROLE_TF->INVOCATION_TF
BEFORE_TT : ROLE_TT->INVOCATION_TT
AFTER_FF : ROLE_FF->OUT_F
AFTER_FT : ROLE_FT->OUT_F
AFTER_TF : ROLE_TF->OUT_F
AFTER_TT : ROLE_TT->OUT_T
IMAGE_FF : [AFTER_FF]
IMAGE_FT : [AFTER_FT]
IMAGE_TF : [AFTER_TF]
IMAGE_TT : [AFTER_TT]
BODY_FF : BEFORE_FF->IMAGE_FF
BODY_FT : BEFORE_FT->IMAGE_FT
BODY_TF : BEFORE_TF->IMAGE_TF
BODY_TT : BEFORE_TT->IMAGE_TT
RULE_FF : ROLE_DICT_FF->BODY_FF
RULE_FT : ROLE_DICT_FT->BODY_FT
RULE_TF : ROLE_DICT_TF->BODY_TF
RULE_TT : ROLE_DICT_TT->BODY_TT
ADMISSION_FF : THEORY->RULE_FF
ADMISSION_FT : THEORY->RULE_FT
ADMISSION_TF : THEORY->RULE_TF
ADMISSION_TT : THEORY->RULE_TT
INDEX_FF : O->ADMISSION_FF
INDEX_FT : O->ADMISSION_FT
INDEX_TF : O->ADMISSION_TF
INDEX_TT : O->ADMISSION_TT
CALLER_FF : ARGS_FF->C
CALLER_FT : ARGS_FT->C
CALLER_TF : ARGS_TF->C
CALLER_TT : ARGS_TT->C
REQ_FF : CALLER_FF->INVOCATION_FF
REQ_FT : CALLER_FT->INVOCATION_FT
REQ_TF : CALLER_TF->INVOCATION_TF
REQ_TT : CALLER_TT->INVOCATION_TT
RESULT_FF : CALLER_FF->OUT_F
RESULT_FT : CALLER_FT->OUT_F
RESULT_TF : CALLER_TF->OUT_F
RESULT_TT : CALLER_TT->OUT_T
SCOPE_SEED_FF : ARGS_FF->O
SCOPE_SEED_FT : ARGS_FT->O
SCOPE_SEED_TF : ARGS_TF->O
SCOPE_SEED_TT : ARGS_TT->O
SCOPE_DESC_FF : SCOPE_SEED_FF->INTERP
SCOPE_DESC_FT : SCOPE_SEED_FT->INTERP
SCOPE_DESC_TF : SCOPE_SEED_TF->INTERP
SCOPE_DESC_TT : SCOPE_SEED_TT->INTERP
SCOPE_FF : SCOPE_FF->SCOPE_DESC_FF
SCOPE_FT : SCOPE_FT->SCOPE_DESC_FT
SCOPE_TF : SCOPE_TF->SCOPE_DESC_TF
SCOPE_TT : SCOPE_TT->SCOPE_DESC_TT
SCOPE_MEMBER_FF : SCOPE_FF->REQ_FF
SCOPE_MEMBER_FT : SCOPE_FT->REQ_FT
SCOPE_MEMBER_TF : SCOPE_TF->REQ_TF
SCOPE_MEMBER_TT : SCOPE_TT->REQ_TT
FOREIGN_SCOPE_SEED_TT : FOREIGN_THEORY->ARGS_TT
FOREIGN_SCOPE_DESC_TT : FOREIGN_SCOPE_SEED_TT->FINTERP
FOREIGN_SCOPE_TT : FOREIGN_SCOPE_TT->FOREIGN_SCOPE_DESC_TT
FOREIGN_SCOPE_MEMBER_TT : FOREIGN_SCOPE_TT->REQ_TT
