R : R->R
O : O->R
C : R->C
L : O->C
U : C->O
T : O->C
F : C->O
AND_SEED : R->L
AND : AND_SEED->O
ARGS_FF : [F,F]
ARGS_FT : [F,T]
ARGS_TF : [T,F]
ARGS_TT : [T,T]
OUT_F : [F]
OUT_T : [T]
AUTH_ROLES : []
AUTH_DICT : AUTH_DICT->AUTH_ROLES
GRAM_SEED : L->U
GRAM : GRAM_SEED->O
THEORY_SEED : U->L
THEORY : THEORY_SEED->C
GT : GRAM->THEORY
INTERP : AUTH_DICT->GT
FOREIGN_THEORY_SEED : THEORY->U
FOREIGN_THEORY : FOREIGN_THEORY_SEED->C
FGT : GRAM->FOREIGN_THEORY
FOREIGN_INTERP : AUTH_DICT->FGT
ROLE_SEED : AND->THEORY
K_FF : ROLE_SEED->O
K_FT : K_FF->O
K_TF : K_FT->O
K_TT : K_TF->O
CALLER_SEED : ROLE_SEED->C
CALLER_FF : CALLER_SEED->O
CALLER_FT : CALLER_FF->O
CALLER_TF : CALLER_FT->O
CALLER_TT : CALLER_TF->O
ROLESEQ_FF : [K_FF]
DICT_FF : DICT_FF->ROLESEQ_FF
TERM_FF : AND->ARGS_FF
INV_FF : O->TERM_FF
BEFORE_FF : K_FF->INV_FF
AFTER_FF : K_FF->OUT_F
IMAGE_FF : [AFTER_FF]
BODY_FF : BEFORE_FF->IMAGE_FF
RULE_FF : DICT_FF->BODY_FF
ADMIT_FF : THEORY->RULE_FF
INDEX_FF : O->ADMIT_FF
REQUEST_FF : CALLER_FF->INV_FF
EXPECTED_FF : CALLER_FF->OUT_F
LAUNCH_FF : [INTERP,REQUEST_FF,EXPECTED_FF]
ROLESEQ_FT : [K_FT]
DICT_FT : DICT_FT->ROLESEQ_FT
TERM_FT : AND->ARGS_FT
INV_FT : O->TERM_FT
BEFORE_FT : K_FT->INV_FT
AFTER_FT : K_FT->OUT_F
IMAGE_FT : [AFTER_FT]
BODY_FT : BEFORE_FT->IMAGE_FT
RULE_FT : DICT_FT->BODY_FT
ADMIT_FT : THEORY->RULE_FT
INDEX_FT : O->ADMIT_FT
REQUEST_FT : CALLER_FT->INV_FT
EXPECTED_FT : CALLER_FT->OUT_F
LAUNCH_FT : [INTERP,REQUEST_FT,EXPECTED_FT]
ROLESEQ_TF : [K_TF]
DICT_TF : DICT_TF->ROLESEQ_TF
TERM_TF : AND->ARGS_TF
INV_TF : O->TERM_TF
BEFORE_TF : K_TF->INV_TF
AFTER_TF : K_TF->OUT_F
IMAGE_TF : [AFTER_TF]
BODY_TF : BEFORE_TF->IMAGE_TF
RULE_TF : DICT_TF->BODY_TF
ADMIT_TF : THEORY->RULE_TF
INDEX_TF : O->ADMIT_TF
REQUEST_TF : CALLER_TF->INV_TF
EXPECTED_TF : CALLER_TF->OUT_F
LAUNCH_TF : [INTERP,REQUEST_TF,EXPECTED_TF]
ROLESEQ_TT : [K_TT]
DICT_TT : DICT_TT->ROLESEQ_TT
TERM_TT : AND->ARGS_TT
INV_TT : O->TERM_TT
BEFORE_TT : K_TT->INV_TT
AFTER_TT : K_TT->OUT_T
IMAGE_TT : [AFTER_TT]
BODY_TT : BEFORE_TT->IMAGE_TT
RULE_TT : DICT_TT->BODY_TT
ADMIT_TT : THEORY->RULE_TT
INDEX_TT : O->ADMIT_TT
REQUEST_TT : CALLER_TT->INV_TT
EXPECTED_TT : CALLER_TT->OUT_T
LAUNCH_TT : [INTERP,REQUEST_TT,EXPECTED_TT]
ENTRY : [LAUNCH_FF,LAUNCH_FT,LAUNCH_TF,LAUNCH_TT]
FOREIGN_LAUNCH_TT : [FOREIGN_INTERP,REQUEST_TT,REQUEST_TT]
