{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/netkeep80/anum_docs/proofs/evidence-record.schema.json",
  "title": "MTS proof evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "theoremId",
    "lane",
    "mts",
    "proofSource",
    "assumptions",
    "dependencies",
    "result",
    "authority",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "mts-proof-evidence/v0.1"
    },
    "theoremId": {
      "type": "string",
      "pattern": "^(FND|INV|CTX|FRM|EXE|TRN|PRF)-[0-9]{2,}$"
    },
    "lane": {
      "type": "string",
      "enum": [
        "typescript",
        "lean4",
        "coq",
        "mtsNative",
        "aprover"
      ]
    },
    "mts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedVersion",
        "sourceCommitSha"
      ],
      "properties": {
        "acceptedVersion": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+$"
        },
        "sourceCommitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contractBlobSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "theoryRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proofSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commitSha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "pin"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "pin": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(FND|INV|CTX|FRM|EXE|TRN|PRF)-[0-9]{2,}$"
      },
      "uniqueItems": true
    },
    "result": {
      "type": "string",
      "enum": [
        "checked",
        "proved",
        "accepted",
        "rejected",
        "counterexample"
      ]
    },
    "authority": {
      "type": "string",
      "enum": [
        "executable-witness",
        "external-cross-check",
        "native-replay",
        "independent-consumer-replay"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^/"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
