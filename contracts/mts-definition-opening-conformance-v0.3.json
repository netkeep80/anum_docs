{
  "schema": "mts-definition-opening-conformance/v0.3",
  "status": "accepted",
  "accepted": true,
  "contract": "mts-definition-opening/v0.3",
  "dependsOn": "mts-definition-opening-challenge/v0.3",
  "promotion": "same challenged vectors promoted after semantic acceptance and production conformance; vector contents are unchanged",
  "resultEncoding": {
    "match": {
      "kind": "match",
      "definitionId": {"scopePath": [], "ordinal": 0},
      "body": "canonical L2 formatting of the exact typed Definition.value"
    },
    "noMatch": {"kind": "no-match"},
    "conflict": {"kind": "conflict"},
    "nonAddressable": {"kind": "non-addressable"}
  },
  "rootOpenings": [
    {
      "target": "∞",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 0}, "body": "{◁ = ∞, ▷ = ∞}"},
      "mustContainUnresolvedContextPronoun": true
    },
    {
      "target": "()",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 1}, "body": "♀() ⟼ ()♂"}
    },
    {
      "target": "([)",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 2}, "body": "(♀∞)"}
    },
    {
      "target": "(])",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 3}, "body": "(∞♂)"}
    },
    {
      "target": "(⟼)",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 4}, "body": "(♀∞ ⟼ ∞♂)"}
    },
    {
      "target": "(↛)",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 5}, "body": "(∞♂ ⟼ ♀∞)"}
    },
    {
      "target": "[1]",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 6}, "body": "(⟼)"}
    },
    {
      "target": "[0]",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 7}, "body": "(↛)"}
    },
    {
      "target": "(=)",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 8}, "body": "{♀◁ = ♀▷, ◁♂ = ▷♂}"},
      "mustContainUnresolvedContextPronoun": true
    },
    {
      "target": "(!=)",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 9}, "body": "¬(=)"}
    }
  ],
  "scenarios": [
    {
      "id": "form-rhs",
      "scopes": [{"path": [], "definitions": ["a : b"]}],
      "lookupScope": [],
      "target": "a",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 0}, "body": "b"}
    },
    {
      "id": "constraint-bundle-rhs",
      "scopes": [{"path": [], "definitions": ["c : {◁ = c, ▷ = c}"]}],
      "lookupScope": [],
      "target": "c",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 0}, "body": "{◁ = c, ▷ = c}"},
      "mustContainUnresolvedContextPronoun": true
    },
    {
      "id": "self-one-step",
      "scopes": [{"path": [], "definitions": ["a : a"]}],
      "lookupScope": [],
      "target": "a",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 0}, "body": "a"},
      "mustStopAfterOneOpening": true
    },
    {
      "id": "mutual-a-one-step",
      "scopes": [{"path": [], "definitions": ["a : b", "b : a"]}],
      "lookupScope": [],
      "target": "a",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 0}, "body": "b"},
      "mustStopAfterOneOpening": true
    },
    {
      "id": "mutual-b-one-step",
      "scopes": [{"path": [], "definitions": ["a : b", "b : a"]}],
      "lookupScope": [],
      "target": "b",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 1}, "body": "a"},
      "mustStopAfterOneOpening": true
    },
    {
      "id": "child-shadowing",
      "scopes": [
        {"path": [], "definitions": ["a : b"]},
        {"path": [0], "parent": [], "definitions": ["a : c"]}
      ],
      "lookupScope": [0],
      "target": "a",
      "expected": {"kind": "match", "definitionId": {"scopePath": [0], "ordinal": 0}, "body": "c"}
    },
    {
      "id": "parent-fallback",
      "scopes": [
        {"path": [], "definitions": ["a : b"]},
        {"path": [0], "parent": [], "definitions": []}
      ],
      "lookupScope": [0],
      "target": "a",
      "expected": {"kind": "match", "definitionId": {"scopePath": [], "ordinal": 0}, "body": "b"}
    },
    {
      "id": "missing",
      "scopes": [{"path": [], "definitions": ["a : b"]}],
      "lookupScope": [],
      "target": "z",
      "expected": {"kind": "no-match"}
    },
    {
      "id": "same-scope-duplicate",
      "scopes": [{"path": [], "definitions": ["a : b", "a : c"]}],
      "lookupScope": [],
      "target": "a",
      "expected": {"kind": "conflict"}
    },
    {
      "id": "anonymous-target",
      "scopes": [{"path": [], "definitions": ["[] : a"]}],
      "lookupScope": [],
      "target": "[]",
      "expected": {"kind": "non-addressable"}
    },
    {
      "id": "start-pronoun-target",
      "scopes": [{"path": [], "definitions": ["◁ : a"]}],
      "lookupScope": [],
      "target": "◁",
      "expected": {"kind": "non-addressable"}
    },
    {
      "id": "end-pronoun-target",
      "scopes": [{"path": [], "definitions": ["▷ : a"]}],
      "lookupScope": [],
      "target": "▷",
      "expected": {"kind": "non-addressable"}
    }
  ],
  "nonObservables": [
    "source span offsets",
    "display-only labels beyond canonical L2 formatting",
    "target structural-key serialization",
    "persistent LinkRef or backend address",
    "MemoryView state",
    "proof state"
  ]
}
