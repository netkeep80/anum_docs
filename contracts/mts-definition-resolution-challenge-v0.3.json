{
  "schema": "mts-definition-resolution-challenge/v0.3",
  "status": "candidate-challenge",
  "dependsOn": "mts-contract/v0.2",
  "issue": 121,
  "purpose": "challenge controlled resolution of self-closed MTS definitions before any production interpreter or proof-rule change",
  "currentBoundary": {
    "definitionAst": "Definition(target: Form, value: Expression)",
    "rootRegistry": "DifferenceRegistry built from top-level typed Definition nodes",
    "currentInterpreterAcceptedInputs": [
      "Equality",
      "Inequality",
      "ConstraintBundle"
    ],
    "definitionIsCurrentlyExecutableByInterpretConstraints": false,
    "definitionMayMaterialize": false,
    "globalTextualRewriteAccepted": false
  },
  "requiredDistinctions": [
    "definition-introduction",
    "definition-lookup",
    "definition-resolution",
    "form-matching",
    "proof-step",
    "memory-realization"
  ],
  "candidateModels": [
    {
      "id": "global-textual-rewrite",
      "accepted": false,
      "disposition": "reject",
      "reason": "collapses occurrence/context identity and recreates the removed legacy substitution model"
    },
    {
      "id": "eager-recursive-normalization",
      "accepted": false,
      "disposition": "reject",
      "reason": "self-closed definitions such as the root system do not admit naive finite full unfolding"
    },
    {
      "id": "finite-definition-graph-resolution",
      "accepted": false,
      "disposition": "challenge",
      "idea": "resolve explicit definition identities through a finite visited graph and report cycle edges instead of recursively expanding forever"
    },
    {
      "id": "contextual-coinductive-resolution",
      "accepted": false,
      "disposition": "challenge",
      "idea": "treat repeated definition/context state as a replayable cycle reference rather than a request for further textual expansion"
    }
  ],
  "finiteGraphChallengeCases": [
    {
      "id": "direct",
      "definitions": ["a : b"],
      "start": "a",
      "expectedVisited": ["a"],
      "expectedCycleEdges": [],
      "expectedExternalLeaves": ["b"],
      "expectedMissingStart": false
    },
    {
      "id": "finite-chain",
      "definitions": ["a : b", "b : c"],
      "start": "a",
      "expectedVisited": ["a", "b"],
      "expectedCycleEdges": [],
      "expectedExternalLeaves": ["c"],
      "expectedMissingStart": false
    },
    {
      "id": "self-reference",
      "definitions": ["a : a"],
      "start": "a",
      "expectedVisited": ["a"],
      "expectedCycleEdges": [["a", "a"]],
      "expectedExternalLeaves": [],
      "expectedMissingStart": false
    },
    {
      "id": "mutual-recursion",
      "definitions": ["a : b", "b : a"],
      "start": "a",
      "expectedVisited": ["a", "b"],
      "expectedCycleEdges": [["b", "a"]],
      "expectedExternalLeaves": [],
      "expectedMissingStart": false
    },
    {
      "id": "missing-start",
      "definitions": ["a : b"],
      "start": "z",
      "expectedVisited": [],
      "expectedCycleEdges": [],
      "expectedExternalLeaves": [],
      "expectedMissingStart": true
    }
  ],
  "identityVeto": {
    "displayTextIsRuntimeIdentity": false,
    "sourceSpanIsRuntimeIdentity": false,
    "anonymousOccurrenceMayBecomeGlobalBySpelling": false,
    "candidateSyntheticGraphCasesUseSymbolTargetsOnly": true,
    "note": "the synthetic graph walker is a challenge instrument, not accepted identity semantics for arbitrary structural definition targets"
  },
  "effectVeto": {
    "definitionResolutionMayRealize": false,
    "definitionResolutionMayDelete": false,
    "lookupEqualsRealize": false,
    "interpretEqualsRealize": false
  },
  "rootProgramMustRemainUnchanged": true,
  "productionInterpreterChangeAllowed": false,
  "acceptedContractLinkAllowed": false,
  "releaseGate": [
    "choose a typed definition identity/environment model",
    "define scope and context behavior",
    "define finite self/mutual recursion semantics",
    "define exact boundary between resolution and equality/rewrite",
    "publish positive and negative cross-language conformance",
    "accept a versioned semantic contract before modifying the single production interpreter",
    "only then expose the accepted operation as a candidate L5 proof rule"
  ]
}
