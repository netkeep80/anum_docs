{
  "schema": "anum-stream-deserialization/v0.3",
  "status": "accepted",
  "accepted": true,
  "issue": 355,
  "semanticReset": 343,
  "theoryIssue": 333,
  "purpose": "Pure denotation of one raw/channel quaternary Anum stream by the explicit stack machine established after semantic reset #343. This is an operational stream subset, not acceptance of Foundation v2 or a universal theorem about every possible Anum carrier.",
  "scope": {
    "input": "raw/channel sequence of quaternary abits",
    "existingAsetCarrierInputAccepted": false,
    "existingAsetCarrierInputDeferredIssue": 333,
    "serializationAcceptedHere": false,
    "materializationAcceptedHere": false,
    "effect": "none"
  },
  "alphabet": {
    "abits": ["[", "]", "1", "0"],
    "exactlyFour": true,
    "rootIsFifthAbit": false,
    "rootIsImplicitContextBasis": true
  },
  "rootBasis": {
    "R": "R = R ⟼ R",
    "O": "O = O ⟼ R",
    "C": "C = R ⟼ C",
    "L": "L = O ⟼ C",
    "U": "U = C ⟼ O",
    "root": "R",
    "transportDictionary": {
      "[": "O",
      "]": "C",
      "1": "L",
      "0": "U"
    }
  },
  "streamInterpreter": {
    "bracketsAreUniversalMtsOpcodes": false,
    "tokenRoles": {
      "[": "OPEN",
      "]": "CLOSE",
      "1": "VALUE(L)",
      "0": "VALUE(U)"
    },
    "bracketRootLinksAreAppendedAsValues": false,
    "state": "stack of frames; each frame has started:boolean and current:Link",
    "newFrame": {
      "started": false,
      "current": "R"
    },
    "OPEN": "push current frame; create new frame(started=false,current=R)",
    "VALUE": "if frame.started=false then current=value and started=true; otherwise current=Link(current,value)",
    "CLOSE": "pop non-root frame; inner = current when started else R; returned = Link(R,inner) when started else R; feed returned to parent through VALUE",
    "FINISH": "root frame must be the only frame; result = current when started else R"
  },
  "denotation": {
    "emptyStream": "R",
    "emptyContext": "R",
    "singleValueDoesNotAddImplicitRootOperand": true,
    "flatSequenceFold": "left fold over VALUE occurrences",
    "nonEmptyNestedContextReturn": "Link(R,innerResult)",
    "emptyNestedContextReturn": "R",
    "nestedResultFeedsParentAsOneValue": true
  },
  "semanticIdentity": {
    "linkIdentity": "by ordered semantic poles",
    "axiom": "Link(A,B)=Link(C,D) iff A=C and B=D",
    "rootCollapse": "Link(R,R)=R",
    "samePairCreatesSecondSemanticLink": false,
    "repeatedSourcePositionCreatesSecondSemanticLink": false,
    "runtimeHandleIsSemanticIdentity": false,
    "sourceOffsetIsSemanticIdentity": false,
    "stackFrameIsSemanticIdentity": false
  },
  "effectBoundary": {
    "denotationReadsOrWritesMemory": false,
    "findEqualsMaterialize": false,
    "notFoundImpliesNonExistence": false,
    "explicitMaterializerMayUseEnsureLink": true,
    "ensureLinkMustReuseSamePair": true
  },
  "errors": {
    "unexpectedCloseRejected": true,
    "unclosedOpenRejected": true,
    "nonAbitInputRejected": true
  },
  "versionBoundary": {
