{
  "schema": "mts-definition-opening/v0.3",
  "status": "accepted",
  "accepted": true,
  "dependsOn": [
    "mts-contract/v0.2"
  ],
  "conformanceCorpus": "contracts/mts-definition-opening-conformance-v0.3.json",
  "issue": 121,
  "scope": "normative one-step read-only definition opening semantics; trusted proof rules remain a separate versioned surface",
  "definitionEnvironment": {
    "identity": {
      "definitionId": "replay-local pair (scopePath, ordinal)",
      "persistentStorageIdentity": false,
      "targetStructuralKeyIsDefinitionIdentity": false,
      "sourceSpanIsDefinitionIdentity": false,
      "displayTextIsDefinitionIdentity": false
    },
    "scopeModel": "explicit lexical scope tree",
    "sameScopeDuplicate": "conflict",
    "childSameTarget": "nearest-scope shadowing",
    "lookupOrder": "current scope then lexical parents",
    "ContextFrameAffectsLookup": false
  },
  "addressability": {
    "rule": "a definition target is addressable only when its typed scalar Form contains neither occurrence-local anonymous empty [] nor ContextPronoun nodes",
    "ordinaryClosedTypedFormsUse": "source-span-independent structural lookup discriminant",
    "structuralLookupDiscriminantImpliesSemanticEquality": false,
    "anonymousEmptySquareTarget": "non-addressable",
    "ContextPronounTarget": "non-addressable",
    "bundleTarget": "non-addressable under the accepted scalar definition-target boundary",
    "reason": "occurrence-local/deictic forms must not become global definition names merely because two ASTs have the same structural spelling"
  },
  "operation": {
    "name": "open_definition",
    "inputs": [
      "typed addressable target Form",
      "explicit lexical DefinitionEnvironment"
    ],
    "doesNotTake": [
      "ContextFrame",
      "MemoryView",
      "symbol-to-LinkRef bindings",
      "proof state"
    ],
    "results": {
      "match": ["DefinitionId", "exact typed Definition.value", "provenance"],
      "no-match": "no visible definition for addressable target",
      "conflict": "same-scope duplicate target makes that nearest lexical target conflicting rather than falling back to a parent",
      "non-addressable": "target is outside the accepted addressable subset"
    },
    "oneStep": true,
    "recursive": false,
    "evaluatesBody": false,
    "resolvesContextPronouns": false,
    "rewritesCallerAst": false,
    "assertsEquality": false,
    "producesProofStep": false,
    "readsL4": false,
    "writesL4": false
  },
  "bodySemantics": {
    "returnedValue": "the exact typed RHS Expression registered by the selected Definition introduction",
    "FormRhsAllowed": true,
    "ConstraintBundleRhsAllowed": true,
    "ContextPronounsRemainTypedAndUnresolved": true,
    "laterContextualInterpretationMayBeChosenExplicitlyByCaller": true,
    "laterInterpretationIsPartOfOpening": false,
    "example": {
      "definition": "∞ : {◁ = ∞, ▷ = ∞}",
      "openingResultBody": "{◁ = ∞, ▷ = ∞}",
      "pronounsResolvedByOpening": false
    }
  },
  "recursion": {
    "self": "a : a opens once to a and stops",
    "mutual": "a : b opens once to b; opening b is another explicit operation",
    "singleStepCycleMarkerRequired": false,
    "multiStepTraversalMustTrackDefinitionId": true,
    "globalNormalFormRequired": false
  },
  "separation": {
    "definitionIsEquality": false,
    "openingIsInterpretation": false,
    "openingIsProofStep": false,
    "openingIsRealize": false,
    "lookupIsRealize": false,
    "globalTextualSubstitution": false,
    "eagerRecursiveNormalization": false
  },
  "rootProgram": {
    "path": "tests/mtc_formulas.mtc",
    "definitionCount": 10,
    "mustRemainUnchanged": true,
    "allCurrentTargetsAddressable": true,
    "allOpenToExactTypedRhs": true
  },
  "productionIntegration": {
    "referenceCore": "core/mtc_definitions.py",
    "rootLibrary": "core/root_library.py",
    "rootValidator": "core/validate_root.py",
    "productionConformance": "tests/test_mts_definition_opening_reference.py",
    "legacyDifferenceRegistryRetained": false,
    "challengeOnlyEnvironmentCloneRetained": false,
    "interpretConstraintsExecutesDefinition": false,
    "reasonInterpretRemainsSeparate": "accepted opening is a definition operation, not a new interpretation branch"
  },
  "integrationStatus": {
    "semanticContractAccepted": true,
    "productionReferenceCoreImplemented": true,
    "canonicalRootLibraryUsesDefinitionEnvironment": true,
    "productionConformancePresent": true,
    "mtsContractV03Published": true,
    "aproverRepinAllowed": false
  },
  "downstream": {
    "genericL2ConsumerMayPinMtsContractV03": true,
    "aproverProofRepinAllowed": false,
    "aproverMustNotInventLocalOpeningSemantics": true,
    "futureProofConsumerMustUseVersionedL5Acceptance": true
  }
}
