{
  "schema": "mts-definition-opening/v0.3",
  "status": "accepted",
  "accepted": true,
  "dependsOn": [
    "mts-contract/v0.2",
    "mts-definition-resolution-challenge/v0.3",
    "mts-definition-environment-decision/v0.3",
    "mts-definition-environment-challenge/v0.3",
    "mts-definition-opening-decision/v0.3",
    "mts-definition-opening-challenge/v0.3"
  ],
  "conformanceCorpus": "contracts/mts-definition-opening-conformance-v0.3.json",
  "issue": 121,
  "scope": "normative one-step read-only definition opening semantics; production integration and trusted proof rules are separate later gates",
  "definitionEnvironment": {
    "identity": {
      "definitionId": "replay-local pair (scopePath, ordinal)",
      "persistentStorageIdentity": false,
      "targetStructuralKeyIsDefinitionIdentity": false,
      "sourceSpanIsDefinitionIdentity": false,
      "displayTextIsDefinitionIdentity": false
    },
    "scopeModel": "explicit lexical scope tree",
    "sameScopeDuplicate": "conflict",
    "childSameTarget": "nearest-scope shadowing",
    "lookupOrder": "current scope then lexical parents",
    "ContextFrameAffectsLookup": false
  },
  "addressability": {
    "rule": "a definition target is addressable only when its typed Form contains neither occurrence-local anonymous empty [] nor ContextPronoun nodes",
    "ordinaryClosedTypedFormsUse": "source-span-independent structural lookup discriminant",
    "structuralLookupDiscriminantImpliesSemanticEquality": false,
    "anonymousEmptySquareTarget": "non-addressable",
    "ContextPronounTarget": "non-addressable",
    "reason": "occurrence-local/deictic forms must not become global definition names merely because two ASTs have the same structural spelling"
  },
  "operation": {
    "name": "open_definition",
    "inputs": [
      "typed addressable target Form",
      "explicit lexical DefinitionEnvironment"
    ],
    "doesNotTake": [
      "ContextFrame",
      "MemoryView",
      "symbol-to-LinkRef bindings",
      "proof state"
    ],
    "results": {
      "match": ["DefinitionId", "exact typed Definition.value", "provenance"],
      "no-match": "no visible definition for addressable target",
      "conflict": "same-scope duplicate target made environment invalid for that introduction",
      "non-addressable": "target is occurrence-local/deictic under the accepted v0.3 subset"
    },
    "oneStep": true,
    "recursive": false,
    "evaluatesBody": false,
    "resolvesContextPronouns": false,
    "rewritesCallerAst": false,
    "assertsEquality": false,
    "producesProofStep": false,
    "readsL4": false,
    "writesL4": false
  },
  "bodySemantics": {
    "returnedValue": "the exact typed RHS Expression registered by the selected Definition introduction",
    "FormRhsAllowed": true,
    "ConstraintBundleRhsAllowed": true,
    "ContextPronounsRemainTypedAndUnresolved": true,
    "laterContextualInterpretationMayBeChosenExplicitlyByCaller": true,
    "laterInterpretationIsPartOfOpening": false,
    "example": {
      "definition": "∞ : {◁ = ∞, ▷ = ∞}",
      "openingResultBody": "{◁ = ∞, ▷ = ∞}",
      "pronounsResolvedByOpening": false
    }
  },
  "recursion": {
    "self": "a : a opens once to a and stops",
    "mutual": "a : b opens once to b; opening b is another explicit operation",
    "singleStepCycleMarkerRequired": false,
    "multiStepTraversalMustTrackDefinitionId": true,
    "globalNormalFormRequired": false
  },
  "separation": {
    "definitionIsEquality": false,
    "openingIsInterpretation": false,
    "openingIsProofStep": false,
    "openingIsRealize": false,
    "lookupIsRealize": false,
    "globalTextualSubstitution": false,
    "eagerRecursiveNormalization": false
  },
  "rootProgram": {
    "path": "tests/mtc_formulas.mtc",
    "definitionCount": 10,
    "mustRemainUnchanged": true,
    "allCurrentTargetsAddressable": true,
    "allOpenToExactTypedRhs": true
  },
  "acceptanceEvidence": {
    "initialResolutionChallenge": "contracts/mts-definition-resolution-challenge-v0.3.json",
    "environmentDecision": "contracts/mts-definition-environment-decision-v0.3.json",
    "environmentChallenge": "contracts/mts-definition-environment-challenge-v0.3.json",
    "openingDecision": "contracts/mts-definition-opening-decision-v0.3.json",
    "openingChallenge": "contracts/mts-definition-opening-challenge-v0.3.json",
    "conformanceCorpus": "contracts/mts-definition-opening-conformance-v0.3.json",
    "rootRegression": "tests/mtc_formulas.mtc"
  },
  "integrationStatus": {
    "semanticContractAccepted": true,
    "productionReferenceCoreImplemented": false,
    "singleProductionInterpreterIntegrated": false,
    "mtsContractV03Published": false,
    "trustedL5RuleAccepted": false,
    "aproverRepinAllowed": false
  },
  "nextGate": {
    "goal": "implement the accepted DefinitionEnvironment/open_definition operation once in canonical production core and prove it against the existing language-neutral corpus",
    "constraints": [
      "do not add a second parser or interpreter",
      "do not modify the ten root definitions",
      "do not turn Definition into Equality",
      "do not add implicit ContextFrame evaluation",
      "do not add L4 reads/effects",
      "delete challenge-only duplicate runtime model once production conformance no longer needs it as independent replay evidence"
    ],
    "afterProductionConformance": "publish mts-contract/v0.3 umbrella and only then evaluate a candidate L5 definition-opening proof rule"
  },
  "downstream": {
    "directRuntimePinBeforeProductionIntegration": false,
    "aproverMustNotInventLocalOpeningSemantics": true,
    "futureConsumerMustUseVersionedV03Umbrella": true
  }
}
