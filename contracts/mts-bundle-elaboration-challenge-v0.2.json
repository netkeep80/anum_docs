{
  "schema": "mts-bundle-elaboration-challenge/v0.2",
  "status": "candidate-challenge",
  "dependsOn": [
    "mts-contract/v0.2",
    "mts-bundle-challenge/v0.2",
    "mts-bundle-decision/v0.2"
  ],
  "acceptedContractLinkAllowed": false,
  "productionSemanticsChanged": false,
  "model": "B",
  "goal": "Demonstrate deterministic static elaboration of one {...} syntax into distinct ConstraintBundle and ValueBundle roles before any production AST/interpreter change.",
  "roles": [
    "ConstraintBundle",
    "ValueBundle"
  ],
  "expectedContexts": {
    "form": "hard ValueBundle requirement",
    "constraint": "hard ConstraintBundle requirement",
    "definition-default": "fallback ConstraintBundle only when bundle evidence is otherwise empty",
    "none": "infer only from static item evidence; reject if no evidence"
  },
  "evidenceRules": [
    {
      "source": "Judgment item or non-empty child elaborated as ConstraintBundle",
      "evidence": "constraint"
    },
    {
      "source": "Form item or non-empty child elaborated as ValueBundle",
      "evidence": "value"
    },
    {
      "source": "empty child bundle before a role is known",
      "evidence": "none"
    }
  ],
  "algorithm": [
    "Parse with the existing syntax parser; do not execute bundle semantics.",
    "Collect static constraint/value evidence from non-empty items, recursively.",
    "If both evidence kinds occur in one bundle, reject statically.",
    "If exactly one evidence kind occurs, choose that bundle role and propagate it to evidence-free empty child bundles.",
    "If no item evidence exists, use hard parent context, constraint-entry context, or definition-default fallback.",
    "If no item evidence and no expected/fallback context exists, reject as statically ambiguous.",
    "After a role is chosen, a hard parent context with the opposite role is a static role-mismatch error.",
    "Only after elaboration may a future semantic layer receive ConstraintBundle or ValueBundle; runtime memory contents never choose the role."
  ],
  "cases": [
    {
      "id": "empty-constraint-entry",
      "source": "{}",
      "entryExpected": "constraint",
      "roles": [
        {"path": [], "role": "ConstraintBundle"}
      ]
    },
    {
      "id": "empty-value-equality-operand",
      "source": "{} = x",
      "entryExpected": "none",
      "roles": [
        {"path": [0], "role": "ValueBundle"}
      ]
    },
    {
      "id": "empty-value-link-operand",
      "source": "{} ⟼ x",
      "entryExpected": "none",
      "roles": [
        {"path": [0], "role": "ValueBundle"}
      ]
    },
    {
      "id": "empty-definition-rhs-fallback",
      "source": "x : {}",
      "entryExpected": "none",
      "roles": [
        {"path": [1], "role": "ConstraintBundle"}
      ]
    },
    {
      "id": "nonempty-constraint-evidence",
      "source": "{x = y, y != z}",
      "entryExpected": "none",
      "roles": [
        {"path": [], "role": "ConstraintBundle"}
      ]
    },
    {
      "id": "nonempty-value-evidence",
      "source": "{x, y}",
      "entryExpected": "none",
      "roles": [
        {"path": [], "role": "ValueBundle"}
      ]
    },
    {
      "id": "value-definition-rhs",
      "source": "b : {x, y}",
      "entryExpected": "none",
      "roles": [
        {"path": [1], "role": "ValueBundle"}
      ]
    },
    {
      "id": "mixed-item-evidence-rejected",
      "source": "{x, y = z}",
      "entryExpected": "none",
      "error": "mixed-bundle-role-evidence"
    },
    {
      "id": "value-at-constraint-entry-rejected",
      "source": "{x, y}",
      "entryExpected": "constraint",
      "error": "bundle-role-mismatch"
    },
    {
      "id": "constraint-in-form-position-rejected",
      "source": "{x = y} = z",
      "entryExpected": "none",
      "error": "bundle-role-mismatch"
    },
    {
      "id": "root-aroot-constraint-bundle",
      "source": "∞ : {◁ = ∞, ▷ = ∞}",
      "entryExpected": "none",
      "roles": [
        {"path": [1], "role": "ConstraintBundle"}
      ]
    },
    {
      "id": "value-bundle-in-sequence",
      "source": "a{x, y}",
      "entryExpected": "none",
      "roles": [
        {"path": [1], "role": "ValueBundle"}
      ]
    },
    {
      "id": "nested-constraint-evidence",
      "source": "{{x = y}}",
      "entryExpected": "none",
      "roles": [
        {"path": [], "role": "ConstraintBundle"},
        {"path": [0], "role": "ConstraintBundle"}
      ]
    },
    {
      "id": "nested-value-evidence",
      "source": "{{x, y}}",
      "entryExpected": "none",
      "roles": [
        {"path": [], "role": "ValueBundle"},
        {"path": [0], "role": "ValueBundle"}
      ]
    },
    {
      "id": "all-empty-nested-at-constraint-entry",
      "source": "{{}}",
      "entryExpected": "constraint",
      "roles": [
        {"path": [], "role": "ConstraintBundle"},
        {"path": [0], "role": "ConstraintBundle"}
      ]
    },
    {
      "id": "all-empty-nested-in-form-position",
      "source": "{{}} = x",
      "entryExpected": "none",
      "roles": [
        {"path": [0], "role": "ValueBundle"},
        {"path": [0, 0], "role": "ValueBundle"}
      ]
    },
    {
      "id": "all-empty-nested-without-context-rejected",
      "source": "{{}}",
      "entryExpected": "none",
      "error": "ambiguous-empty-bundle-role"
    },
    {
      "id": "empty-child-inferred-from-value-sibling",
      "source": "{{}, x}",
      "entryExpected": "none",
      "roles": [
        {"path": [], "role": "ValueBundle"},
        {"path": [0], "role": "ValueBundle"}
      ]
    },
    {
      "id": "empty-child-inferred-from-constraint-sibling",
      "source": "{{}, x = y}",
      "entryExpected": "none",
      "roles": [
        {"path": [], "role": "ConstraintBundle"},
        {"path": [0], "role": "ConstraintBundle"}
      ]
    },
    {
      "id": "constraint-occurrence-paths",
      "source": "{[] = ◁, [] = ▷}",
      "entryExpected": "constraint",
      "roles": [
        {"path": [], "role": "ConstraintBundle"}
      ],
      "squarePaths": [[0, 0], [1, 0]]
    },
    {
      "id": "value-occurrence-paths",
      "source": "{[], []}",
      "entryExpected": "none",
      "roles": [
        {"path": [], "role": "ValueBundle"}
      ],
      "squarePaths": [[0], [1]]
    }
  ],
  "rootRegression": {
    "source": "tests/mtc_formulas.mtc",
    "requireAllCurrentRootsParse": true,
    "requireBundleRootsElaborateConstraint": true,
    "requireNoValueBundleInCurrentRoots": true
  },
  "effectVeto": {
    "readsMemory": false,
    "realizes": false,
    "deletes": false,
    "changesInterpreter": false,
    "changesAst": false,
    "changesParser": false
  },
  "passMeaning": "Model B is statically coherent enough to draft a separate semantic contract. Passing this challenge does not itself accept ValueBundle semantics or its algebra."
}
