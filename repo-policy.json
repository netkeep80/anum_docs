{
  "policy_format_version": "0.3.0",
  "repository_kind": "documentation",
  "enforcement": {
    "mode": "blocking"
  },
  "packs": {
    "contract-conformance": {
      "current": {
        "contract": {
          "path": "contracts/mts-contract-v0.15.json",
          "format": "json"
        },
        "conformance": {
          "path": "contracts/mts-conformance-v0.15.json",
          "format": "json"
        }
      },
      "previous": {
        "contract": {
          "path": "contracts/mts-contract-v0.14.json",
          "format": "json"
        },
        "conformance": {
          "path": "contracts/mts-conformance-v0.14.json",
          "format": "json"
        }
      },
      "pair_fields": {
        "contract_id": "/schema",
        "conformance_contract_id": "/contract",
        "contract_conformance_path": "/conformanceCorpus",
        "contract_status": "/status",
        "conformance_status": "/status",
        "contract_accepted": "/accepted",
        "conformance_accepted": "/accepted"
      },
      "accepted_state": {
        "status": "accepted",
        "accepted": true
      },
      "acceptance": {
        "document": {
          "path": "cutover/typescript-c1-acceptance-v0.8.json",
          "format": "json"
        },
        "current_contract_path": "/current/contract",
        "current_conformance_path": "/current/conformance"
      },
      "required_paths": [
        {
          "document": "current.contract",
          "pointer": "/owners",
          "projection": "object_values"
        },
        {
          "document": "current.conformance",
          "pointer": "/requiredExecutableGates",
          "projection": "array_items"
        },
        {
          "document": "acceptance",
          "pointer": "/current",
          "projection": "object_values"
        }
      ],
      "cochange": [
        "current.contract",
        "current.conformance",
        "acceptance"
      ],
      "control_paths": [
        "contracts/mts-contract-v*.json",
        "contracts/mts-conformance-v*.json",
        "cutover/typescript-c1-acceptance-v*.json"
      ]
    }
  },
  "document_relations": {
    "documents": {
      "repo-guard-workflow": {
        "path": ".github/workflows/repo-guard.yml",
        "format": "yaml"
      },
      "branch-hygiene-workflow": {
        "path": ".github/workflows/branch-hygiene.yml",
        "format": "yaml"
      },
      "v015-requirements": {
        "path": "requirements/mts-v0.15.json",
        "format": "json"
      }
    },
    "rules": [
      {
        "id": "repo-guard-workflow-mode",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/jobs/policy-check/steps/1/with/mode",
          "type": "string"
        },
        "value": "check-pr"
      },
      {
        "id": "repo-guard-workflow-enforcement",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/jobs/policy-check/steps/1/with/enforcement",
          "type": "string"
        },
        "value": "blocking"
      },
      {
        "id": "repo-guard-workflow-permission-contents",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/permissions/contents",
          "type": "string"
        },
        "value": "read"
      },
      {
        "id": "repo-guard-workflow-permission-issues",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/permissions/issues",
          "type": "string"
        },
        "value": "read"
      },
      {
        "id": "repo-guard-workflow-permission-pull-requests",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/permissions/pull-requests",
          "type": "string"
        },
        "value": "read"
      },
      {
        "id": "repo-guard-workflow-action-pin",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "repo-guard-workflow",
          "pointer": "/jobs/policy-check/steps/1/uses",
          "type": "string"
        },
        "value": "netkeep80/repo-guard@c19f29da366c985e2cf162ef7e75f5594f60c3a2"
      },
      {
        "id": "branch-hygiene-permission-contents-write",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "branch-hygiene-workflow",
          "pointer": "/permissions/contents",
          "type": "string"
        },
        "value": "write"
      },
      {
        "id": "branch-hygiene-permission-pull-requests-write",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "branch-hygiene-workflow",
          "pointer": "/permissions/pull-requests",
          "type": "string"
        },
        "value": "write"
      },
      {
        "id": "branch-hygiene-ensure-pr-job",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "branch-hygiene-workflow",
          "pointer": "/jobs/ensure-pr/name",
          "type": "string"
        },
        "value": "Ensure draft PR for side branch"
      },
      {
        "id": "branch-hygiene-delete-merged-job",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "branch-hygiene-workflow",
          "pointer": "/jobs/delete-merged-head/name",
          "type": "string"
        },
        "value": "Delete merged PR head branch"
      },
      {
        "id": "branch-hygiene-sweep-job",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "branch-hygiene-workflow",
          "pointer": "/jobs/sweep-fully-merged/name",
          "type": "string"
        },
        "value": "Sweep fully merged stale branches"
      },
      {
        "id": "v015-requirements-status",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "v015-requirements",
          "pointer": "/status",
          "type": "string"
        },
        "value": "accepted"
      },
      {
        "id": "v015-requirements-contract",
        "kind": "scalar_equals_literal",
        "source": {
          "document": "v015-requirements",
          "pointer": "/contract",
          "type": "string"
        },
        "value": "contracts/mts-contract-v0.15.json"
      }
    ]
  },
  "evidence_bindings": [
    {
      "id": "negative-vectors-have-test-evidence",
      "kind": "anchor_value_coverage",
      "source": {
        "document": "contract-conformance.current.conformance",
        "pointer": "/requiredNegativeVectors",
        "projection": "array_items",
        "type": "string_set"
      },
      "target_anchor_type": "negative_vector_test"
    },
    {
      "id": "accepted-semantic-laws-have-doc-owners",
      "kind": "anchor_value_coverage",
      "source": {
        "document": "contract-conformance.current.contract",
        "pointer": "/requiredSemanticLaws",
        "projection": "object_keys",
        "type": "string_set"
      },
      "target_anchor_type": "semantic_law_registry_owner"
    }
  ],
  "anchors": {
    "types": {
      "negative_vector_test": {
        "sources": [
          {
            "kind": "regex",
            "glob": "ts/test/release-cutover.test.ts",
            "pattern": "negativeVector\\(\"([^\"]+)\""
          },
          {
            "kind": "regex",
            "glob": "ts/test/v014-release-cutover-a75.test.ts",
            "pattern": "negativeVector\\(\\\"([^\\\"]+)\\\""
          },
          {
            "kind": "regex",
            "glob": "ts/test/v015-requirements-traceability-r0.test.ts",
            "pattern": "negativeVector\\(\"([^\"]+)\""
          }
        ]
      },
      "semantic_law_owner": {
        "sources": [
          {
            "kind": "regex",
            "glob": "docs/specs/Формальная нотация МТС.md",
            "pattern": "<a id=\"mts-law-([A-Za-z][A-Za-z0-9]*)\"></a>\\s*<!--\\s*нормативный владелец\\s*-->"
          },
          {
            "kind": "regex",
            "glob": "docs/specs/Ачисла и сериализация.md",
            "pattern": "<a id=\"mts-law-([A-Za-z][A-Za-z0-9]*)\"></a>\\s*<!--\\s*нормативный владелец\\s*-->"
          },
          {
            "kind": "regex",
            "glob": "docs/specs/Апамять и управление сетью связей.md",
            "pattern": "<a id=\"mts-law-([A-Za-z][A-Za-z0-9]*)\"></a>\\s*<!--\\s*нормативный владелец\\s*-->"
          }
        ]
      },
      "semantic_law_reference": {
        "sources": [
          {
            "kind": "regex",
            "glob": "README.md",
            "pattern": "<!--\\s*ссылка:mts-law-([A-Za-z][A-Za-z0-9]*)\\s*-->"
          },
          {
            "kind": "regex",
            "glob": "docs/**/*.md",
            "pattern": "<!--\\s*ссылка:mts-law-([A-Za-z][A-Za-z0-9]*)\\s*-->"
          }
        ]
      },
      "semantic_law_registry_owner": {
        "sources": [
          {
            "kind": "regex",
            "glob": "requirements/mts-v0.15.json",
            "pattern": "\\\"id\\\"\\s*:\\s*\\\"(V15-[A-Z0-9-]+)\\\""
          }
        ]
      }
    }
  },
  "paths": {
    "forbidden": [
      "legacy/**",
      "archive/**",
      "old/**",
      "deprecated/**",
      "*.bak",
      "*.tmp",
      "*.orig",
