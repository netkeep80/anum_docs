  },
  "diff_rules": {
    "max_new_docs": 0,
    "max_new_files": 4,
    "max_net_added_lines": 800
  },
  "size_rules": [
    {
      "id": "contracts-file-count-no-growth",
      "scope": "directory",
      "metric": "files",
      "glob": "contracts/**",
      "max": 10,
      "max_growth": 2,
      "count": "all_tracked",
      "level": "blocking"
    },
    {
      "id": "typescript-tests-controlled-growth",
      "scope": "directory",
      "metric": "files",
      "glob": "ts/test/**",
      "max": 1000,
      "max_growth": 1,
      "count": "all_tracked",
      "level": "blocking"
    }
  ],
  "content_rules": [
    {
      "id": "readme-russian-first",
      "glob": "README.md",
      "mode": "markdown_language",
      "language": "ru",
      "allow_words": [
        "API",
        "ASCII",
        "CI",
        "CLI",
        "Git",
        "GitHub",
        "JSON",
        "Python",
        "TypeScript",
        "UTF",
        "mts-readme-contract-observatory",
        "mts-readme-authors"
      ],
      "max_unapproved_latin_words_per_line": 1
    },
    {
      "id": "readme-required-project-metadata",
      "glob": "README.md",
      "mode": "required_regex",
      "require_regex": [
        "https://netkeep80\\.github\\.io/anum_docs/",
        "Вертушкин Роман Павлович",
        "Дьяченко Константин Константинович",
        "Шакиров Тимур Эдуардович",
        "Бурдуков Александр Николаевич",
        "Глазунов Иван Сергеевич"
      ]
    },
    {
      "id": "mts-docs-russian-first",
      "glob": "docs/**/*.md",
      "mode": "markdown_language",
      "language": "ru",
      "allow_words": [
        "API",
        "ASCII",
        "CI",
        "CLI",
        "Git",
        "GitHub",
        "JSON",
        "Python",
        "TypeScript",
        "UTF"
      ],
      "max_unapproved_latin_words_per_line": 1
    },
    {
      "id": "observatory-site-russian-presentation",
      "glob": "web/contract-observatory/src/site.ts",
      "mode": "added_lines",
      "forbid_regex": [
        "MTS Contract Observatory",
        ">Contract Observatory<",
        ">Timeline<",
        ">Version Overview<",
        "Primary explanatory view",
        "Methodology map \\+ version lifecycle lanes",
        "Method/lifecycle relation",
        "Traceability/evidence relation",
        "Semantic topology Link: not rendered in this view",
        "Methodology stages",
        "Version and evidence filters",
        "Reset viewport",
        "Invariant anatomy",
        "Source-derived provenance view",
        "Contract JSON Pointer",
        "Genesis vectors",
        "Meaning vectors",
        "Compatibility vectors",
        "Negative vectors",
        "Executable gates",
        "Existing evidence",
        "Acceptance provenance",
        "Raw provenance",
        "Source-derived traceability relations",
        "Evidence/source endpoint",
        "Obligation/target endpoint",
        "Generated deterministically"
      ]
    },
    {
      "id": "observatory-controller-russian-presentation",
      "glob": "web/contract-observatory/src/browser-controller.ts",
      "mode": "added_lines",
      "forbid_regex": [
        "Selected:"
      ]
    }
  ],
  "cochange_rules": [
    {
      "if_changed": [
        "web/contract-observatory/src/site.ts",
        "web/contract-observatory/src/browser-controller.ts"
      ],
      "must_change_any": [
        "web/contract-observatory/test/localization.test.ts"
      ]
    },
    {
      "if_changed": [
        "requirements/mts-v0.13.json",
        "contracts/mts-contract-v0.13.json",
        "traceability/mts-v0.13.json"
