  "requirements": [
    {
      "id": "AEP-01-current-semantic-state",
      "statement": "The current semantic state is exactly the members of the single published current Scope."
    },
    {
      "id": "AEP-02-physical-history-non-authority",
      "statement": "Physically retained older Scopes and truths do not become current merely by remaining stored."
    },
    {
      "id": "AEP-03-theory-authority",
      "statement": "The selected Link-carried Theory defines the admitted grounded relations for execution."
    },
    {
      "id": "AEP-04-reaction-start-theory-snapshot",
      "statement": "At logical reaction start the executable Theory frontier is frozen as TheorySnapshot_t."
    },
    {
      "id": "AEP-05-one-snapshot-per-reaction",
      "statement": "Every current member in reaction t is evaluated against the same TheorySnapshot_t."
    },
    {
      "id": "AEP-06-exhaustive-admitted-images",
      "statement": "For each current truth K->A, all relations admitted by the snapshot with antecedent A are exhausted."
    },
    {
      "id": "AEP-07-no-admitted-relation-preserves",
      "statement": "If no admitted relation exists for A, K->A is preserved in the successor semantic state."
    },
    {
      "id": "AEP-08-admitted-relations-replace-by-union",
      "statement": "If one or more admitted relations exist, the old current truth contributes the canonical union of every K->B_j output."
    },
    {
      "id": "AEP-09-zero-is-empty-contribution",
      "statement": "An admitted ZERO image contributes no successor truth and does not veto outputs of other simultaneously admitted relations."
    },
    {
      "id": "AEP-10-canonical-convergence",
      "statement": "Duplicate successor truths converge by canonical Link identity; physical occurrence count and carrier order are non-semantic."
    },
    {
      "id": "AEP-11-build-successor-before-publication",
      "statement": "The complete successor Scope is constructed before it can become current."
    },
    {
      "id": "AEP-12-single-atomic-current-root-handoff",
      "statement": "When matchedRelations is greater than zero, exactly one atomic current-root handoff publishes the completed successor Scope."
    },
    {
      "id": "AEP-13-quiescence-is-complete-no-match",
      "statement": "When the complete logical reaction has matchedRelations equal to zero, no handoff occurs and the current state is quiescent."
    },
    {
      "id": "AEP-14-theory-writes-visible-next-reaction",
      "statement": "Theory admissions materialized during reaction t are executable beginning with reaction t+1, not by physical intra-reaction order."
    },
    {
      "id": "AEP-15-schedule-address-layout-non-authority",
      "statement": "Physical scheduling, local handles, allocation order, indexes and backend layout cannot change the normalized semantic result."
    },
    {
      "id": "AEP-16-nontermination-allowed",
      "statement": "Recurrence and unbounded execution are permitted; the profile does not require global termination."
    },
    {
      "id": "AEP-17-structural-end-is-not-global-halt",
      "statement": "The structural END aspect alone is not a universal global halt instruction."
    }
  ],
