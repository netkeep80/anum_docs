# Корневая система МТС v0.2.
# Каждая непустая строка без # — именованное определение формальной нотации.
# Query/conformance-примеры не входят в корень.

# Акорень: оба полюса текущего контекста совпадают с самим акорнем.
∞ : {◁ = ∞, ▷ = ∞}

# Минимальная формальная форма смысла.
() : ♀() ⟼ ()♂

# Смыслы двух квадратных полюсных знаков.
([) : (♀∞)
(]) : (∞♂)

# Смысл связи и смысл несвязи.
(⟼) : (♀∞ ⟼ ∞♂)
(↛) : (∞♂ ⟼ ♀∞)

# Квадратные формы абитов связи/несвязи.
[1] : (⟼)
[0] : (↛)

# Равенство двух полюсов текущего бинарного контекста.
(=) : {♀◁ = ♀▷, ◁♂ = ▷♂}

# Неравенство — инверсия смысла равенства.
(!=) : ¬(=)
