# EXPERIMENTAL — candidate root program for contextual formal notation v0.2.
# This file is not normative and does not replace tests/mtc_formulas.mtc yet.
#
# Principle:
#   root contains named/reified semantic definitions;
#   parser sugar, projection mechanics, sequence laws and bundle expansion
#   belong to executable conformance tests instead of the axiom surface.

# Акорень. При проверке кандидата ∞ интерпретатор создаёт ContextFrame
# из его двух полюсов; оба полюса должны разрешаться в сам ∞.
∞ : {◁ = ∞, ▷ = ∞}

# Минимальная формальная форма смысла.
() : ♀() ⟼ ()♂

# Смыслы двух квадратных полюсных знаков.
([) : (♀∞)
(]) : (∞♂)

# Смысл связи и смысл несвязи.
(⟼) : (♀∞ ⟼ ∞♂)
(↛) : (∞♂ ⟼ ♀∞)

# Квадратные формы абитов связи/несвязи.
[1] : (⟼)
[0] : (↛)

# Равенство двух полюсов текущего бинарного контекста.
# ◁ и ▷ — два атомарных односимвольных местоимения.
# Глубже работают обычные операторы МТС; скобки [ ] здесь не перегружаются.
(=) : {♀◁ = ♀▷, ◁♂ = ▷♂}

# Неравенство — инверсия смысла равенства.
(!=) : ¬(=)
